<Project>
  <ItemGroup>
    <_XoderonyStrideUIAsset Include="Assets\**\*.sduipage;Assets\**\*.sduilib" />
    <_XoderonyStrideUIAsset Remove="@(AdditionalFiles)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
    <AdditionalFiles Include="@(_XoderonyStrideUIAsset)" />
    <_XoderonyStrideUIAsset Remove="@(_XoderonyStrideUIAsset)" />
  </ItemGroup>
</Project>
