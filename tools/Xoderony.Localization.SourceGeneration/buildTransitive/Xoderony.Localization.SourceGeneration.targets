<Project>
  <PropertyGroup>
    <XoderonyLocalizationDefaultNamespace Condition="'$(XoderonyLocalizationDefaultNamespace)' == ''">$(RootNamespace)</XoderonyLocalizationDefaultNamespace>
    <XoderonyLocalizationDefaultNamespace Condition="'$(XoderonyLocalizationDefaultNamespace)' == ''">Xoderony.Localization</XoderonyLocalizationDefaultNamespace>
    <XoderonyLocalizationDefaultTypeName Condition="'$(XoderonyLocalizationDefaultTypeName)' == ''">StringTableKeys</XoderonyLocalizationDefaultTypeName>
  </PropertyGroup>
  <ItemGroup>
    <AdditionalFiles Update="@(AdditionalFiles)">
      <XoderonyLocalizationNamespace Condition="'%(AdditionalFiles.XoderonyLocalizationGenerate)' == 'true' And '%(AdditionalFiles.XoderonyLocalizationNamespace)' == ''">$(XoderonyLocalizationDefaultNamespace)</XoderonyLocalizationNamespace>
      <XoderonyLocalizationTypeName Condition="'%(AdditionalFiles.XoderonyLocalizationGenerate)' == 'true' And '%(AdditionalFiles.XoderonyLocalizationTypeName)' == ''">$(XoderonyLocalizationDefaultTypeName)</XoderonyLocalizationTypeName>
    </AdditionalFiles>
  </ItemGroup>
</Project>
