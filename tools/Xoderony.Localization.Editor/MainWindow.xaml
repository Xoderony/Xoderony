<Window x:Class="Xoderony.Localization.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Xoderony.Localization.Editor"
        Title="{Binding [window.title]}"
        Style="{StaticResource EditorWindowStyle}"
        Width="1280"
        Height="800"
        MinWidth="760"
        MinHeight="560"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="OnLoaded"
        Closing="OnClosing"
        PreviewKeyDown="OnPreviewKeyDown">
  <Window.Resources>
    <DataTemplate x:Key="NameCellTemplate">
      <Grid ToolTip="{Binding Node.FullKey}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Style="{StaticResource NodeTypeIconTextStyle}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding DisplayName}"
                   VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource VsToolbarBrush}"
            BorderBrush="{DynamicResource VsBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,6">
      <WrapPanel Orientation="Horizontal">
        <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
          <Button x:Name="ProjectMenuButton"
                  Style="{StaticResource ToolbarButtonStyle}"
                  Click="OpenProjectMenu">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" Style="{StaticResource ToolbarIconTextStyle}" />
              <TextBlock Text="{Binding [toolbar.project]}" />
            </StackPanel>
            <Button.ContextMenu>
              <ContextMenu Opened="PopulateProjectMenu" />
            </Button.ContextMenu>
          </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding [language.label]}" Margin="0,0,7,0" VerticalAlignment="Center" />
          <ComboBox x:Name="LanguageComboBox"
                    Width="150"
                    ItemsSource="{Binding Cultures}"
                    SelectedItem="{Binding Culture, Mode=OneWay}"
                    SelectionChanged="LanguageChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding NativeName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding [theme.label]}" Margin="0,0,7,0" VerticalAlignment="Center" />
          <ComboBox x:Name="ThemeComboBox"
                    Width="120"
                    SelectionChanged="ThemeChanged">
            <ComboBoxItem Content="{Binding [theme.light]}" Tag="{x:Static local:EditorTheme.Light}" />
            <ComboBoxItem Content="{Binding [theme.dark]}" Tag="{x:Static local:EditorTheme.Dark}" />
          </ComboBox>
        </StackPanel>
      </WrapPanel>
    </Border>

    <Border Grid.Row="1"
            Background="{DynamicResource VsSurfaceBrush}"
            BorderBrush="{DynamicResource VsBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="3*" MinWidth="160" />
          <ColumnDefinition Width="2*" MinWidth="220" MaxWidth="360" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding [path.label]}" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
        <Grid Grid.Column="1" Margin="12,0">
          <TextBlock x:Name="PathPlaceholderText"
                     Text="{Binding [path.unopened]}"
                     Foreground="{DynamicResource VsMutedTextBrush}"
                     VerticalAlignment="Center" />
          <ScrollViewer x:Name="BreadcrumbScrollViewer"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        Visibility="Collapsed">
            <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" />
          </ScrollViewer>
        </Grid>
        <Grid Grid.Column="2" VerticalAlignment="Center">
          <TextBox x:Name="SearchTextBox"
                   Height="30"
                   Padding="30,4,28,4"
                   TextChanged="SearchChanged" />
          <TextBlock Text="&#xE721;"
                     Style="{StaticResource IconTextStyle}"
                     Foreground="{DynamicResource VsMutedTextBrush}"
                     Margin="9,0,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False" />
          <TextBlock Text="{Binding [search.placeholder]}"
                     Foreground="{DynamicResource VsMutedTextBrush}"
                     Margin="30,0,0,0"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Button Width="26"
                  Height="26"
                  Padding="0"
                  Margin="0,2,2,2"
                  HorizontalAlignment="Right"
                  Style="{StaticResource ToolbarButtonStyle}"
                  Click="ClearSearch"
                  ToolTip="{Binding [search.clear_tooltip]}">
            <TextBlock Text="&#xE711;" Style="{StaticResource SmallIconTextStyle}" />
          </Button>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Background="{DynamicResource VsSurfaceBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition x:Name="ValidationPanelRow" Height="0" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <DataGrid x:Name="TableGrid"
                  Margin="10"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False"
                  FrozenColumnCount="1"
                  IsReadOnly="True"
                  Visibility="Collapsed"
                  MouseDoubleClick="HandleCellDoubleClick"
                  PreviewMouseRightButtonDown="SelectRowOnRightClick">
          <DataGrid.ContextMenu>
            <ContextMenu Opened="PopulateTableContextMenu" />
          </DataGrid.ContextMenu>
        </DataGrid>

        <Border x:Name="EmptyState"
                Margin="10"
                Background="{DynamicResource VsSurfaceBrush}"
                BorderBrush="{DynamicResource VsBorderBrush}"
                BorderThickness="1">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="&#xE8E5;"
                       Style="{StaticResource EmptyStateIconTextStyle}"
                       Foreground="{DynamicResource VsAccentBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,14" />
            <TextBlock Text="{Binding [empty_state.title]}" Style="{StaticResource EmptyStateTitleTextStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding [empty_state.description]}"
                       Foreground="{DynamicResource VsMutedTextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,18" />
            <Button Click="OpenDirectory" Padding="18,7" Content="{Binding [empty_state.select_directory]}" />
          </StackPanel>
        </Border>
      </Grid>

      <GridSplitter x:Name="ValidationGridSplitter"
                    Grid.Row="1"
                    Height="5"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource VsBorderBrush}"
                    ResizeDirection="Rows"
                    ResizeBehavior="PreviousAndNext"
                    Visibility="Collapsed" />

      <Border x:Name="ValidationPanel"
              Grid.Row="2"
              Margin="10,0,10,10"
              Background="{DynamicResource VsSurfaceBrush}"
              BorderBrush="{DynamicResource VsBorderBrush}"
              BorderThickness="1"
              Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0"
                  Background="{DynamicResource VsToolbarBrush}"
                  BorderBrush="{DynamicResource VsBorderBrush}"
                  BorderThickness="0,0,0,1"
                  Padding="10,6">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock x:Name="ValidationSummaryText" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="ValidationCompletionText"
                           Margin="0,3,12,0"
                           Foreground="{DynamicResource VsMutedTextBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1"
                      Grid.Row="0"
                      Width="26"
                      Height="26"
                      Padding="0"
                      Style="{StaticResource ToolbarButtonStyle}"
                      Click="CloseValidationPanel"
                      ToolTip="{Binding [validation.close_tooltip]}">
                <TextBlock Text="&#xE711;" Style="{StaticResource SmallIconTextStyle}" />
              </Button>
              <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding [validation.filter_kind_label]}" Margin="0,0,7,0" VerticalAlignment="Center" />
                  <ComboBox x:Name="ValidationKindFilterComboBox"
                            Width="190"
                            SelectionChanged="ValidationFilterChanged" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="{Binding [validation.filter_locale_label]}" Margin="0,0,7,0" VerticalAlignment="Center" />
                  <ComboBox x:Name="ValidationLocaleFilterComboBox"
                            Width="180"
                            SelectionChanged="ValidationFilterChanged" />
                </StackPanel>
              </WrapPanel>
            </Grid>
          </Border>
          <Grid Grid.Row="1">
            <DataGrid x:Name="ValidationGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="False"
                      IsReadOnly="True"
                      MouseDoubleClick="NavigateToValidationIssue">
              <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding KindText}" Width="180" MinWidth="130">
                  <DataGridTextColumn.Header>
                    <TextBlock Text="{Binding [validation.column_kind]}" />
                  </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding EntryKey}" Width="*" MinWidth="220">
                  <DataGridTextColumn.Header>
                    <TextBlock Text="{Binding [validation.column_key]}" />
                  </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding CultureName}" Width="180" MinWidth="120">
                  <DataGridTextColumn.Header>
                    <TextBlock Text="{Binding [validation.column_locale]}" />
                  </DataGridTextColumn.Header>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="ValidationEmptyText"
                       Text="{Binding [validation.no_issues]}"
                       Foreground="{DynamicResource VsMutedTextBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

  </Grid>
</Window>
