<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Xoderony.Localization.Editor</RootNamespace>
    <AssemblyName>Xoderony.Localization.Editor</AssemblyName>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <Description>Desktop editor for Xoderony JSON string tables.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Xoderony.Channels\Xoderony.Channels.csproj" />
    <ProjectReference Include="..\..\src\Xoderony.Localization\Xoderony.Localization.csproj" />
    <ProjectReference Include="..\..\src\Xoderony.Localization.Json\Xoderony.Localization.Json.csproj" />
    <ProjectReference Include="..\..\src\Xoderony.Localization.Tooling\Xoderony.Localization.Tooling.csproj" />
    <ProjectReference Include="..\Xoderony.Localization.SourceGeneration\Xoderony.Localization.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="XoderonyLocalizationGenerate" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="XoderonyLocalizationNamespace" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="XoderonyLocalizationTypeName" />
    <None Update="Localization\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <AdditionalFiles Include="Localization\keys.json">
      <XoderonyLocalizationGenerate>true</XoderonyLocalizationGenerate>
      <XoderonyLocalizationNamespace>Xoderony.Localization.Editor</XoderonyLocalizationNamespace>
      <XoderonyLocalizationTypeName>EditorStringKeys</XoderonyLocalizationTypeName>
    </AdditionalFiles>
  </ItemGroup>
</Project>
