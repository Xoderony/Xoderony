<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="VsWindowColor">#F5F5F5</Color>
  <Color x:Key="VsSurfaceColor">#FFFFFF</Color>
  <Color x:Key="VsToolbarColor">#F3F3F3</Color>
  <Color x:Key="VsBorderColor">#D6D6D6</Color>
  <Color x:Key="VsTextColor">#1E1E1E</Color>
  <Color x:Key="VsMutedTextColor">#666666</Color>
  <Color x:Key="VsAccentColor">#007ACC</Color>
  <Color x:Key="VsAccentHoverColor">#1C97EA</Color>
  <Color x:Key="VsHoverColor">#E5F1FB</Color>
  <Color x:Key="VsSelectionColor">#CCE8FF</Color>
  <Color x:Key="VsSelectionBorderColor">#99D1FF</Color>
  <Color x:Key="VsDangerColor">#C42B1C</Color>
  <Color x:Key="VsHorizontalGridLineColor">#ECECEC</Color>
  <Color x:Key="VsVerticalGridLineColor">#E3E3E3</Color>

  <SolidColorBrush x:Key="VsWindowBrush" Color="{StaticResource VsWindowColor}" />
  <SolidColorBrush x:Key="VsSurfaceBrush" Color="{StaticResource VsSurfaceColor}" />
  <SolidColorBrush x:Key="VsToolbarBrush" Color="{StaticResource VsToolbarColor}" />
  <SolidColorBrush x:Key="VsBorderBrush" Color="{StaticResource VsBorderColor}" />
  <SolidColorBrush x:Key="VsTextBrush" Color="{StaticResource VsTextColor}" />
  <SolidColorBrush x:Key="VsMutedTextBrush" Color="{StaticResource VsMutedTextColor}" />
  <SolidColorBrush x:Key="VsAccentBrush" Color="{StaticResource VsAccentColor}" />
  <SolidColorBrush x:Key="VsAccentHoverBrush" Color="{StaticResource VsAccentHoverColor}" />
  <SolidColorBrush x:Key="VsHoverBrush" Color="{StaticResource VsHoverColor}" />
  <SolidColorBrush x:Key="VsSelectionBrush" Color="{StaticResource VsSelectionColor}" />
  <SolidColorBrush x:Key="VsSelectionBorderBrush" Color="{StaticResource VsSelectionBorderColor}" />
  <SolidColorBrush x:Key="VsDangerBrush" Color="{StaticResource VsDangerColor}" />
  <SolidColorBrush x:Key="VsHorizontalGridLineBrush" Color="{StaticResource VsHorizontalGridLineColor}" />
  <SolidColorBrush x:Key="VsVerticalGridLineBrush" Color="{StaticResource VsVerticalGridLineColor}" />
</ResourceDictionary>
