<Project>
  <!-- Same idea as Cysharp/ZString: authoritative .cs live in src/; building copies them into the UPM Runtime folder. -->
  <PropertyGroup>
    <UnityPackageId Condition="'$(UnityPackageId)' == ''">io.github.$([System.String]::Copy('$(MSBuildProjectName)').ToLowerInvariant())</UnityPackageId>
    <UnityRuntimeRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\unity\$(UnityPackageId)\Runtime\'))</UnityRuntimeRoot>
  </PropertyGroup>

  <Target Name="SyncUnitySources" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net10.0' And Exists('$(UnityRuntimeRoot)')">
    <ItemGroup>
      <_SrcCs Include="$(MSBuildProjectDirectory)\**\*.cs" Exclude="$(MSBuildProjectDirectory)\bin\**\*.cs;$(MSBuildProjectDirectory)\obj\**\*.cs" />
      <_UnityCs Include="$(UnityRuntimeRoot)**\*.cs" />
    </ItemGroup>
    <Delete Files="@(_UnityCs)" />
    <Copy SourceFiles="@(_SrcCs)" DestinationFiles="$(UnityRuntimeRoot)%(RecursiveDir)%(Filename)%(Extension)" SkipUnchangedFiles="true" />
  </Target>
</Project>
