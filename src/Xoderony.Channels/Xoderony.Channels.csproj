<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <RootNamespace>Xoderony</RootNamespace>
    <AssemblyName>Xoderony.Channels</AssemblyName>
    <PackageId>Xoderony.Channels</PackageId>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Description>Delegate channels and shared value channels with separate access capabilities. No UnityEngine dependency.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\unity\io.github.xoderony.channels\Runtime\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
