<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>Xoderony.Localization</RootNamespace>
    <AssemblyName>Xoderony.Localization</AssemblyName>
    <PackageId>Xoderony.Localization</PackageId>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Description>Dependency-free localization contracts for Unity and .NET applications.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Collections.Immutable" Version="10.0.11" />
    <Compile Include="..\..\unity\io.github.xoderony.localization\Runtime\**\*.cs" Exclude="..\..\unity\io.github.xoderony.localization\Runtime\Json\**\*.cs;..\..\unity\io.github.xoderony.localization\Runtime\Tooling\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
