# Keep every detected text file as LF in both the repository and working tree.
* text=auto eol=lf

# Use Git's C#-aware diff driver.
*.cs diff=csharp

# Common binary assets and build artifacts.
*.dll binary
*.pdb binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.tga binary
*.zip binary
*.unitypackage binary
